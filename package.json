{
  "name": "acessario",
  "private": true,
  "version": "1.0.0",
  "description": "AcessaRio — navegação urbana inclusiva com rotas acessíveis e mapa colaborativo.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.js\"",
    "api": "node server/index.js",
    "api:reset": "node server/reset.js",
    "dev:http": "concurrently -k -n api,web \"npm run api\" \"vite --mode http\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
