{
  "name": "acessario",
  "private": true,
  "version": "1.0.0",
  "description": "AcessaRio — navegação urbana inclusiva com rotas acessíveis e mapa colaborativo.",
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n api,web -c blue,green \"npm run api\" \"npm run dev\"",
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "api": "node server/index.js",
    "api:reset": "node server/reset.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@vercel/blob": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
