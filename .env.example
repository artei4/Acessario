# Copie para .env se quiser mudar algo. Nenhuma chave é necessária.

# --- Mapa ---
# "osm" (padrão): OpenStreetMap com Leaflet. "schematic": mapa esquemático em SVG, sem internet.
VITE_MAP_PROVIDER=osm

# --- API REST ---
# "http" (padrão) usa o servidor de server/ (npm start).
# "local" roda o mesmo núcleo REST dentro do navegador, sem servidor (npm run dev:demo).
VITE_API_MODE=http
# Em desenvolvimento, o padrão é http://localhost:3001; publicado na Vercel, /api.
# VITE_API_URL=http://localhost:3001
