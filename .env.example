# Copie para .env e preencha.

# --- Google Maps JavaScript API ---
# Chave do Google Cloud com a "Maps JavaScript API" ativada.
# Sem chave, o app usa o mapa esquemático em SVG.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID do Google Cloud (necessário para marcadores avançados e tema escuro).
# DEMO_MAP_ID funciona para desenvolvimento.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# --- API REST ---
# "http" (padrão) usa o servidor de server/ (npm start).
# "local" roda o mesmo núcleo REST dentro do navegador, sem servidor (npm run dev:demo).
VITE_API_MODE=http
VITE_API_URL=http://localhost:3001
